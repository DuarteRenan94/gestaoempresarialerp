<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GestaoEmpresarialERP.Ui.RelatorioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GestaoEmpresarialERP"
    xmlns:entity="using:GestaoEmpresarialERP.Entities"
    xmlns:views="using:GestaoEmpresarialERP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="10" RowSpacing="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0">
            <ListView x:Name="lstVendas">
                <ListView.Header>
                    <Grid BorderThickness="0, 0, 0, 1" BorderBrush="Gray" Padding="10,0,10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Center">Nome</TextBlock>
                        <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center">Preço</TextBlock>
                        <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center">Quantidade</TextBlock>
                        <TextBlock Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Center">Data</TextBlock>
                        <TextBlock Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Center">Total</TextBlock>
                        <TextBlock Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Center">Forma de Pagamento</TextBlock>
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:RelatorioView">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="{x:Bind Nome}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{x:Bind x:String.Format(x:Null, 'R$ {0:F2}', Preco)}"/>
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{x:Bind Quantidade}"/>
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="{x:Bind Data}"/>
                            <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="{x:Bind x:String.Format(x:Null, 'R$ {0:F2}', Subtotal)}"/>
                            <TextBlock Grid.Column="5" HorizontalAlignment="Center" Text="{x:Bind FormaPagamento}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Faturamento"/>
                        <TextBlock Grid.Column="1" x:Name="TxFaturamento"/>
                    </Grid>
                </ListView.Footer>
            </ListView>
        </ScrollViewer>
        <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Button_Click">Voltar</Button>
        </Grid>
    </Grid>
</Page>
