<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GestaoEmpresarialERP.Ui.VendaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GestaoEmpresarialERP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:GestaoEmpresarialERP.Views"
    xmlns:entity="using:GestaoEmpresarialERP.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="5" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontWeight="Bold" HorizontalAlignment="Center" Text="Id"/>
            <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Center" Text="Nome"/>
            <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Center" Text="Preço"/>
            <TextBlock Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Center" Text="Quantidade"/>
            <TextBlock Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Center" Text="Total"/>
        </Grid>
        <ListView Grid.Row="1" x:Name="lstPedido">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:ServicoView">
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="{x:Bind Id}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Text="{x:Bind Nome}"/>
                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{x:Bind x:String.Format(x:Null, 'R$ {0:F2}', Preco)}"/>
                        <TextBlock Grid.Column="3" HorizontalAlignment="Center" Text="{x:Bind Quantidade}"/>
                        <TextBlock Grid.Column="4" HorizontalAlignment="Center" Text="{x:Bind x:String.Format(x:Null, 'R$ {0:F2}', Total)}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" ColumnSpacing="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="Voltar_Click">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="2">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xe72b;"/>
                    <TextBlock Text="Voltar"/>
                </StackPanel>
            </Button>
            <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="190" x:Name="CbFormas" PlaceholderText="Forma de Pagamento" SelectedValuePath="Id" SelectedValue="{x:Bind IdFormaSelecionada, Mode=TwoWay}"/>
            <Button x:Name="BtnRegistrar" Grid.Column="2" Click="BtnRegistrar_Click">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="2">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xe74e;"/>
                    <TextBlock Text="Registrar Venda"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
